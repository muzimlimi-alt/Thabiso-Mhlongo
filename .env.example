# Server Configuration
PORT=3000
NODE_ENV=production

# Security
SESSION_SECRET=your_long_random_session_secret_here

# Database
DB_PATH=./thabiso_mhlongo.db

# Runtime storage locations (Phase 3 housekeeping — see HOUSEKEEPING-NOTES.md). All three default
# to a sibling folder outside the repository if left unset, so generated files can never
# accidentally be committed. Point these at real deployment paths in production.
# DOCS_PATH=./docs
# UPLOADS_PATH=./images
# BACKUPS_PATH=./backups

# Outgoing email / SMTP (Microsoft 365 shown). These are deployment DEFAULTS: whatever is saved in
# Admin > System Settings > Email (SMTP) takes precedence. The password is a secret - never commit it. If SMTP_PASS is left
# empty here, enter the password on that admin screen instead (it is stored encrypted). Microsoft 365 needs "Authenticated SMTP"
# enabled for the mailbox AND the tenant. See docs-internal/smtp-email.md.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
# starttls (port 587) or ssl (port 465). Mail is never sent unencrypted.
SMTP_SECURE=starttls
SMTP_USER=bookings@thabisomhlongo.com
SMTP_PASS=
SMTP_FROM=bookings@thabisomhlongo.com
SMTP_FROM_NAME=Thabiso Mhlongo
# Sign-in method: unset / "password" uses SMTP_USER + SMTP_PASS; "oauth" is Microsoft 365 app sign-in (no mailbox password - recommended,
# see docs-internal/smtp-email.md). These can also be entered on the admin screen instead; the client secret is a SECRET - never commit it.
# SMTP_AUTH=oauth
# SMTP_OAUTH_TENANT_ID=
# SMTP_OAUTH_CLIENT_ID=
# SMTP_OAUTH_CLIENT_SECRET=
# Key that encrypts the SMTP password saved from the admin screen (falls back to SESSION_SECRET). Changing it means re-entering
# the password.
# SETTINGS_ENCRYPTION_KEY=
# ONLY for a TLS-intercepting antivirus/proxy whose certificate Node does not trust. Leave unset otherwise.
# SMTP_TLS_REJECT_UNAUTHORIZED=false
# Legacy: EMAIL_USER / EMAIL_PASS (a Gmail app password) still work, but only while no complete SMTP configuration exists.

# External APIs
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# Browser key for the ADMIN portal's Google Maps / Places (served to signed-in admins by /api/admin/maps-config; never put it in a
# tracked file). Restrict it by HTTP referrer to your admin domain and to the Maps JavaScript + Places APIs.
# Keep it separate from the server-side GOOGLE_MAPS_API_KEY above (server requests carry no referrer).
GOOGLE_MAPS_BROWSER_KEY=your_google_maps_browser_key_here

# Google Calendar Integration
# Requires service account JSON or OAuth2 credentials
GOOGLE_CALENDAR_ID=primary
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URL=http://localhost:3000/oauth2callback

# Proxies in front of the app: 1 on Render alone, 2 once Cloudflare sits in front of Render. Wrong
# values break client IPs (rate limits, consent evidence) and PayFast's source-IP check.
TRUST_PROXY_HOPS=1
