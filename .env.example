# Server Configuration
PORT=3000
NODE_ENV=production

# Security
SESSION_SECRET=your_long_random_session_secret_here

# Database
DB_PATH=./thabiso_mhlongo.db

# Runtime storage locations (Phase 3 housekeeping — see HOUSEKEEPING-NOTES.md). All three default
# to a sibling folder outside the repository if left unset, so generated files can never
# accidentally be committed. Point these at real deployment paths in production.
# DOCS_PATH=./docs
# UPLOADS_PATH=./images
# BACKUPS_PATH=./backups

# Outgoing email / SMTP (Microsoft 365 shown). These are deployment DEFAULTS: whatever is saved in
# Admin > System Settings > Email (SMTP) takes precedence. The password is a secret - never commit it. If SMTP_PASS is left
# empty here, enter the password on that admin screen instead (it is stored encrypted). Microsoft 365 needs "Authenticated SMTP"
# enabled for the mailbox AND the tenant. See docs-internal/smtp-email.md.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
# starttls (port 587) or ssl (port 465). Mail is never sent unencrypted.
SMTP_SECURE=starttls
SMTP_USER=bookings@thabisomhlongo.com
SMTP_PASS=
SMTP_FROM=bookings@thabisomhlongo.com
SMTP_FROM_NAME=Thabiso Mhlongo
# Sign-in method: unset / "password" uses SMTP_USER + SMTP_PASS; "oauth" is Microsoft 365 app sign-in (no mailbox password - recommended,
# see docs-internal/smtp-email.md). These can also be entered on the admin screen instead; the client secret is a SECRET - never commit it.
# SMTP_AUTH=oauth
# SMTP_OAUTH_TENANT_ID=
# SMTP_OAUTH_CLIENT_ID=
# SMTP_OAUTH_CLIENT_SECRET=
# Key that encrypts the SMTP password saved from the admin screen (falls back to SESSION_SECRET). Changing it means re-entering
# the password.
# SETTINGS_ENCRYPTION_KEY=
# ONLY for a TLS-intercepting antivirus/proxy whose certificate Node does not trust. Leave unset otherwise.
# SMTP_TLS_REJECT_UNAUTHORIZED=false
# Legacy: EMAIL_USER / EMAIL_PASS (a Gmail app password) still work, but only while no complete SMTP configuration exists.

# PayFast. On the live site these are entered in Admin > Settings (stored in the database, which takes precedence over this file).
# A LOCAL / development run must use PayFast's SANDBOX - never the live merchant. Create your OWN free sandbox account at
# https://sandbox.payfast.co.za (enter your e-mail); its dashboard shows your merchant id, key and passphrase. (PayFast's shared test merchant
# 10000100 cannot be used for a signed checkout: it carries a passphrase nobody here knows, so every signature we send is refused.)
#   PAYFAST_URL=https://sandbox.payfast.co.za/eng/process
#   PAYFAST_MERCHANT_ID=<your sandbox merchant id>
#   PAYFAST_MERCHANT_KEY=<your sandbox merchant key>
#   PAYFAST_PASSPHRASE=<your sandbox passphrase>
# BASE_URL is the public site (the links in emails); a developer's copy usually names the LIVE site. PayFast sends its notification (ITN)
# to <base>/api/payment/webhook/payfast and returns the buyer to <base>, so for a local sandbox run set PAYFAST_BASE_URL - it overrides
# BASE_URL for PayFast's URLs only. http://localhost:3000 returns the buyer to your local site, but PayFast cannot reach localhost to
# deliver the notification, so on a local run the buyer sees "payment successful" and the booking stays unpaid.
# PAYFAST_BASE_URL=http://localhost:3000
# To receive the notification locally run `node scripts/dev-itn-forwarder.js --write-env` (starts an ngrok tunnel that forwards ONLY PayFast's
# webhook to the local site and writes this line for you), then restart the site. It overrides the notification URL alone; the buyer's return
# and cancel pages keep using PAYFAST_BASE_URL. Never set it on the live site.
# PAYFAST_NOTIFY_BASE_URL=https://<your-tunnel>.ngrok-free.app
# The PayFast safety net (docs-internal/payfast.md): if PayFast received a payment but its notification never arrived, the payment is found in PayFast's
# own transaction history and recorded. It is ON by default and uses the merchant id / passphrase above; set this to switch it off.
# PAYFAST_RECONCILE=off

# External APIs
# Google Places (venue / location search) - ONE server-side key for the whole site: the public booking form and every admin
# drawer search through this server (lib/places.js); no Google key is ever sent to a browser.
# In Google Cloud Console: enable "Places API (New)" on the key's project, and restrict the key by API (Places API (New))
# and by IP address (your server's). Do NOT give it HTTP-referrer restrictions - server requests carry no referrer.
# The project needs active billing, and the key must be a plain API key (NOT "Authenticate API calls through a service account").
# Admin > System Settings > "Test Google Places" reports exactly what Google says about this key.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# Optional: auto (default - Places API (New), falling back to the legacy Places API if New isn't enabled) | new | legacy
# PLACES_API_MODE=auto
# Optional: limit suggestions to countries (ISO codes, comma-separated), e.g. za
# PLACES_REGION_CODES=
# GOOGLE_MAPS_BROWSER_KEY is no longer used (the admin's browser-side Google Maps script was removed); delete it from .env.

# Google Calendar Integration
# Requires service account JSON or OAuth2 credentials
GOOGLE_CALENDAR_ID=primary
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URL=http://localhost:3000/oauth2callback

# Proxies in front of the app: 1 on Render alone, 2 once Cloudflare sits in front of Render. Wrong
# values break client IPs (rate limits, consent evidence) and PayFast's source-IP check.
TRUST_PROXY_HOPS=1
