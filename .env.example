# Server Configuration
PORT=3000
NODE_ENV=production

# Security
SESSION_SECRET=your_long_random_session_secret_here

# Database
DB_PATH=./thabiso_mhlongo.db

# Runtime storage locations (Phase 3 housekeeping — see HOUSEKEEPING-NOTES.md). All three default
# to a sibling folder outside the repository if left unset, so generated files can never
# accidentally be committed. Point these at real deployment paths in production.
# DOCS_PATH=../thabiso-mhlongo-runtime-data/docs
# UPLOADS_PATH=../thabiso-mhlongo-runtime-data/uploads
# BACKUPS_PATH=../thabiso-mhlongo-runtime-data/backups

# SMTP Configuration (Outlook/Gmail)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=bookings@thabisomhlongo.com
SMTP_PASS=your_password_here
SMTP_FROM='"Thabiso Mhlongo Management" <bookings@thabisomhlongo.com>'

# External APIs
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Calendar Integration
# Requires service account JSON or OAuth2 credentials
GOOGLE_CALENDAR_ID=primary
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URL=http://localhost:3000/oauth2callback
