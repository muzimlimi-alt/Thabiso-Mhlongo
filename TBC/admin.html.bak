                                            <i class="fa-regular fa-envelope um-input-icon"></i>
                                            <input type="text" id="newsletterSubject" class="um-input" placeholder="e.g. November Tour Dates + New Video!" required>
                                        </div>
                                    </div>
                                    <div class="um-field-group">
                                        <label class="um-label">Message Content</label>
                                        <textarea id="newsletterMessage" style="display:none;"></textarea>
                                        <div id="newsletterEditorContainer">
                                            <div id="newsletterEditor"></div>
                                        </div>
                                    </div>

                                    <div class="um-security-tips" style="margin-bottom: 18px;">
                                        <i class="fa-solid fa-circle-info"></i>
                                        <span>The email will automatically wrap in your dark-themed premium brand style and append an unsubscribe link at the bottom.</span>
                                    </div>

                                    <button type="submit" class="um-btn um-btn--primary" id="newsletterSubmitBtn" style="width:100%; justify-content:center;">
                                        <i class="fa-solid fa-paper-plane"></i> Send Newsletter
