<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thabiso Mhlongo | Admin Portal</title>
    <link rel="icon" href="images/icon.png" type="image/gif" sizes="16x16" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="css/bootstrap.min.css" rel="stylesheet">
    <link href="css/style.css" rel="stylesheet">
    <link href="css/redesign.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.19/css/intlTelInput.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet">
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js'></script>
    <style>
        /* Quill editor dark theme for newsletter composer */
        #newsletterEditorContainer .ql-toolbar.ql-snow {
            background: #181818; border: 1px solid #333; border-bottom: none;
            border-radius: 8px 8px 0 0; padding: 8px 10px;
        }
        #newsletterEditorContainer .ql-container.ql-snow {
            background: #101010; border: 1px solid #333;
            border-radius: 0 0 8px 8px; min-height: 280px;
        }
        #newsletterEditorContainer .ql-editor {
            color: #e0e0e0; font-size: 14px; font-family: inherit;
            min-height: 280px; padding: 14px 16px;
        }
        #newsletterEditorContainer .ql-editor.ql-blank::before {
            color: #444; font-style: normal;
        }
        #newsletterEditorContainer .ql-snow .ql-stroke { stroke: #aaa; }
        #newsletterEditorContainer .ql-snow .ql-fill  { fill: #aaa; }
        #newsletterEditorContainer .ql-snow .ql-picker { color: #aaa; }
        #newsletterEditorContainer .ql-snow .ql-picker-options { background: #1a1a1a; border-color: #333; }
        #newsletterEditorContainer .ql-toolbar.ql-snow .ql-formats button:hover .ql-stroke,
        #newsletterEditorContainer .ql-toolbar.ql-snow .ql-formats button.ql-active .ql-stroke { stroke: #D4AF37; }
        #newsletterEditorContainer .ql-toolbar.ql-snow .ql-formats button:hover .ql-fill,
        #newsletterEditorContainer .ql-toolbar.ql-snow .ql-formats button.ql-active .ql-fill  { fill: #D4AF37; }
    </style>
    <style>
        /* Force Newsletter Visibility */
        .admin-sidebar li[role="presentation"] a[href="#newsletterAdmin"] { display: flex !important; }
    </style>
</head>

<body class="admin-body">
    <!--<h1 class="sr-only">Administration Dashboard</h1>-->
    <!-- Mobile Header/Trigger Area (Subtle replacement for main header on mobile) -->
    <div class="tm-mobile-top-bar" style="display: none;">
    <img src="images/logo4.png" style="max-height: 30px;" alt="Logo">
    </div>

    <div id="loginSection" class="container admin-layout" style="margin-top: 50px; text-align: center; max-width: 400px; display: none;">

        <div class="admin-card text-left" style="background: rgba(34, 34, 34, 0.5); backdrop-filter: blur(5px); border: 1px solid rgba(255, 255, 255, 0.1);">
            <div style="text-align: center; margin-bottom: 20px;">
                <a href="index.html"><img src="images/logo4.png" style="max-height: 80px;" alt="Thabiso Mhlongo Logo"></a>
            </div>
            <h3 style="margin-top: 0; text-align: center;">Admin Portal</h3>
            <hr>
            <form id="adminLoginForm">
                <div class="form-group">
                    <label>Username</label>
                    <input type="text" id="adminUsername" class="form-control" required autofocus>
                </div>
                <div class="form-group">
                    <label>Password</label>
                    <input type="password" id="adminPassword" class="form-control" required>
                </div>
                <div id="loginError" class="alert alert-danger" style="display: none; padding: 10px; margin-top: 10px;"></div>
                <button type="submit" id="loginBtn" class="btn btn-block btn-admin-primary" style="margin-top: 20px;">Login</button>
                <div style="text-align: center; margin-top: 15px;">
                    <a href="#" onclick="toggleForgotPassword(event)" style="color: #aaa; font-size: 13px; text-decoration: underline; transition: 0.3s;" onmouseover="this.style.color='var(--y-base)';" onmouseout="this.style.color='#aaa';">Forgot Your Password?</a>
                </div>
            </form>
        </div>
        
        <!-- Forgot Password Card (Hidden by default) -->
        <div id="forgotPasswordCard" class="admin-card text-left" style="background: rgba(34, 34, 34, 0.5); backdrop-filter: blur(5px); border: 1px solid rgba(255, 255, 255, 0.1); display: none;">
            <div style="text-align: center; margin-bottom: 20px;">
                <a href="index.html"><img src="images/logo4.png" style="max-height: 50px;" alt="Thabiso Mhlongo Logo"></a>
            </div>
            <h4 style="margin-top: 0; text-align: center; color: #fff;">Reset Password</h4>
            <p style="text-align: center; font-size: 13px; color: #ccc;">Enter your registered email address to receive a secure password reset link.</p>
            <hr>
            <form id="adminForgotForm">
                <div class="form-group">
                    <label>Email Address</label>
                    <input type="email" id="forgotEmail" class="form-control" placeholder="admin@domain.com" required>
                </div>
                <div id="forgotMessage" class="alert" style="display: none; padding: 10px; margin-top: 10px; font-size: 13px;"></div>
                <button type="submit" id="forgotBtn" class="btn btn-block btn-admin-primary" style="margin-top: 20px;">Send Reset Link</button>
                <div style="text-align: center; margin-top: 15px;">
                    <a href="#" onclick="toggleForgotPassword(event)" style="color: #aaa; font-size: 13px; text-decoration: underline; transition: 0.3s;" onmouseover="this.style.color='var(--y-base)';" onmouseout="this.style.color='#aaa';"><i class="fa fa-arrow-left"></i> Back to Login</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Dashboard Container (Hidden until authenticated) -->
    <div id="dashboardSection" class="tm-admin-wrapper" style="display: none;">
        
        <!-- Mobile Overlay -->
        <div class="tm-sidebar-overlay" id="tmSidebarOverlay"></div>
        
        <!-- Side Navigation -->
        <aside class="tm-admin-sidebar collapsed" id="tmAdminSidebar">
            <div class="tm-admin-sidebar-header">
                <!--<img src="images/logo4.png" alt="Logo" class="tm-admin-logo">-->
                <span class="tm-admin-sidebar-brand">Admin Portal</span>
                
                <button type="button" class="tm-admin-sidebar-toggle" id="tmSidebarToggle" aria-label="Toggle Sidebar">
                    <i class="fa-solid fa-bars"></i>
                </button>
            </div>
            
            <div class="tm-admin-sidebar-scroll">
                <ul class="nav admin-sidebar" role="tablist">
                    <li role="presentation" class="active">
                        <a href="#dashboardAdmin" aria-controls="dashboardAdmin" role="tab" data-toggle="tab" title="Dashboard">
                            <i class="fa fa-home"></i> <span class="tm-nav-text">Dashboard</span>
                        </a>
                    </li>
                    
                    <li class="tm-sidebar-group-title"><span style="color:#D4AF37">Website Content</span></li>
                    <li role="presentation"><a href="#homeAdmin" aria-controls="homeAdmin" role="tab" data-toggle="tab" title="Home Slider"><i class="fa-solid fa-images"></i> <span class="tm-nav-text">Home Slider</span></a></li>
                    <li role="presentation"><a href="#aboutAdmin" aria-controls="aboutAdmin" role="tab" data-toggle="tab" title="About Me"><i class="fa-solid fa-user-astronaut"></i> <span class="tm-nav-text">About Me</span></a></li>
                    <li role="presentation"><a href="#careerAdmin" aria-controls="careerAdmin" role="tab" data-toggle="tab" title="Career Highlights"><i class="fa-solid fa-star"></i> <span class="tm-nav-text">Career</span></a></li>
                    <li role="presentation"><a href="#galleryAdmin" aria-controls="galleryAdmin" role="tab" data-toggle="tab" title="Gallery"><i class="fa-solid fa-image"></i> <span class="tm-nav-text">Gallery</span></a></li>
                    
                    <li class="tm-sidebar-group-title"><span style="color:#D4AF37">Interactions</span></li>
                    <li role="presentation"><a href="#socialAdmin" aria-controls="socialAdmin" role="tab" data-toggle="tab" title="Social Media"><i class="fa-solid fa-share-nodes"></i> <span class="tm-nav-text">Socials</span></a></li>
                    <li role="presentation"><a href="#eventsAdmin" aria-controls="eventsAdmin" role="tab" data-toggle="tab" title="Upcoming Events"><i class="fa-regular fa-calendar-days"></i> <span class="tm-nav-text">Events</span></a></li>
                    <li role="presentation"><a href="#contactAdmin" aria-controls="contactAdmin" role="tab" data-toggle="tab" title="Contact Me"><i class="fa-solid fa-address-book"></i> <span class="tm-nav-text">Contact</span></a></li>
                    <li role="presentation"><a href="#inquiriesAdmin" aria-controls="inquiriesAdmin" role="tab" data-toggle="tab" title="Inquiries"><i class="fa-solid fa-envelope-open-text"></i> <span class="tm-nav-text">Inquiries</span></a></li>
                    <li role="presentation"><a href="#bookingsAdmin" aria-controls="bookingsAdmin" role="tab" data-toggle="tab" title="Bookings"><i class="fa-solid fa-calendar-check"></i> <span class="tm-nav-text">Bookings</span></a></li>
                    <li role="presentation"><a href="#calendarAdmin" aria-controls="calendarAdmin" role="tab" data-toggle="tab" title="Unified Calendar"><i class="fa-solid fa-calendar-days"></i> <span class="tm-nav-text">Calendar</span></a></li>
                    <li role="presentation"><a href="#financeAdmin" aria-controls="financeAdmin" role="tab" data-toggle="tab" title="Financials"><i class="fa-solid fa-file-invoice-dollar"></i> <span class="tm-nav-text">Finance</span></a></li>
                    
                    <li class="tm-sidebar-group-title"><span style="color:#D4AF37">System</span></li>
                    <li role="presentation"><a href="#newsletterAdmin" aria-controls="newsletterAdmin" role="tab" data-toggle="tab" title="Newsletter"><i class="fa-solid fa-envelopes-bulk"></i> <span class="tm-nav-text">Newsletter</span></a></li>
                    <li role="presentation"><a href="#emailLogsAdmin" aria-controls="emailLogsAdmin" role="tab" data-toggle="tab" title="Email Logs"><i class="fa-solid fa-clock-rotate-left"></i> <span class="tm-nav-text">Logs</span></a></li>
                    <li role="presentation"><a href="#preferencesAdmin" aria-controls="preferencesAdmin" role="tab" data-toggle="tab" title="Preferences"><i class="fa-solid fa-paint-roller"></i> <span class="tm-nav-text">Preferences</span></a></li>
                    <li role="presentation"><a href="#usersAdmin" aria-controls="usersAdmin" role="tab" data-toggle="tab" title="User Management"><i class="fa-solid fa-users-gear"></i> <span class="tm-nav-text">Users</span></a></li>
                    <li role="presentation"><a href="#securityAdmin" aria-controls="securityAdmin" role="tab" data-toggle="tab" title="Security & Audit"><i class="fa-solid fa-shield-halved"></i> <span class="tm-nav-text">Security</span></a></li>
                </ul>
            </div>

            <!-- Sidebar Footer: Global Actions -->
            <div class="tm-admin-sidebar-footer">
                <ul class="nav admin-sidebar">
                    <li>
                        <a href="index.html" title="View Live Site">
                            <i class="fa-solid fa-arrow-up-right-from-square"></i> <span class="tm-nav-text">Live Site</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" id="logoutBtn" class="logout-action" title="Logout">
                            <i class="fa-solid fa-right-from-bracket"></i> <span class="tm-nav-text">Logout</span>
                        </a>
                    </li>
                </ul>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="tm-admin-main admin-layout">
            <button type="button" class="tm-mobile-admin-open" id="tmMobileAdminOpen">
                <i class="fa-solid fa-bars"></i> Menu
            </button>

            <!-- ============== ADMIN CONTROL BAR ============== -->
            <header class="adm-header" id="adminControlBar" role="banner" aria-label="Admin control bar">
                <div class="adm-header__inner">

                    <!-- LEFT: Breadcrumb -->
                    <div class="adm-header__left">
                        <div class="adm-breadcrumb" id="admBreadcrumb" aria-live="polite">
                            <span class="adm-breadcrumb__root">
                                <i class="fa-solid fa-gauge-high" aria-hidden="true"></i>
                                <span>Dashboard</span>
                            </span>
                        </div>
                    </div>

                    <!-- CENTRE: Global Search -->
                    <div class="adm-header__centre">
                        <div class="adm-search" role="search">
                            <i class="fa-solid fa-magnifying-glass adm-search__icon" aria-hidden="true"></i>
                            <input
                                type="text"
                                id="admGlobalSearch"
                                class="adm-search__input"
                                placeholder="Search bookings, inquiries, events…"
                                autocomplete="off"
                                aria-label="Search across all sections"
                                aria-controls="admSearchResults"
                                aria-expanded="false"
                            >
                            <kbd class="adm-search__shortcut" aria-hidden="true">/</kbd>
                            <!-- Results dropdown -->
                            <div class="adm-search__results" id="admSearchResults" role="listbox" aria-label="Search results" style="display:none;"></div>
                        </div>
                    </div>

                    <!-- RIGHT: Utility Cluster -->
                    <div class="adm-header__right">

                        <!-- Create / Add New -->
                        <div class="adm-dropdown" id="admCreateDropdown">
                            <button class="adm-create-btn" id="admCreateTrigger" aria-haspopup="true" aria-expanded="false" aria-controls="admCreateMenu" title="Create new record">
                                <i class="fa-solid fa-plus" aria-hidden="true"></i>
                                <span class="adm-btn-label">New</span>
                                <i class="fa-solid fa-chevron-down adm-caret" aria-hidden="true"></i>
                            </button>
                            <div class="adm-dropdown__menu" id="admCreateMenu" role="menu" aria-label="Create new">
                                <div class="adm-dropdown__header">Create New</div>
                                <button class="adm-dropdown__item" role="menuitem" id="admNewBooking">
                                    <i class="fa-solid fa-calendar-check" aria-hidden="true"></i>
                                    <div>
                                        <span class="adm-dropdown__item-title">Booking</span>
                                        <span class="adm-dropdown__item-sub">Schedule a new gig</span>
                                    </div>
                                </button>
                                <button class="adm-dropdown__item" role="menuitem" id="admNewInquiry">
                                    <i class="fa-solid fa-envelope-open-text" aria-hidden="true"></i>
                                    <div>
                                        <span class="adm-dropdown__item-title">Inquiry</span>
                                        <span class="adm-dropdown__item-sub">Compose a new message</span>
                                    </div>
                                </button>
                                <button class="adm-dropdown__item" role="menuitem" id="admNewEvent">
                                    <i class="fa-regular fa-calendar-days" aria-hidden="true"></i>
                                    <div>
                                        <span class="adm-dropdown__item-title">Event</span>
                                        <span class="adm-dropdown__item-sub">Add upcoming event</span>
                                    </div>
                                </button>
                            </div>
                        </div>

                        <!-- Notifications -->
                        <div class="adm-dropdown" id="admNotiDropdown">
                            <button class="adm-icon-btn" id="admNotiTrigger" aria-haspopup="true" aria-expanded="false" aria-controls="admNotiMenu" title="Notifications">
                                <i class="fa-solid fa-bell" aria-hidden="true"></i>
                                <span class="adm-badge" id="admNotiBadge" style="display:none;" aria-label="unread notifications"></span>
                            </button>
                            <div class="adm-dropdown__menu adm-dropdown__menu--wide" id="admNotiMenu" role="menu" aria-label="Recent activity">
                                <div class="adm-dropdown__header">
                                    <span>Recent Activity</span>
                                    <button class="adm-dropdown__header-action" id="admNotiRefresh" title="Refresh">
                                        <i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
                                    </button>
                                </div>
                                <div id="admNotiList" class="adm-noti-list">
                                    <!-- Rendered by JS -->
                                    <div class="adm-noti-empty">
                                        <i class="fa-regular fa-bell-slash"></i>
                                        <p>No recent activity</p>
                                    </div>
                                </div>
                                <div class="adm-dropdown__footer">
                                    <a href="#" id="admNotiViewAll" class="adm-dropdown__footer-link">View all activity</a>
                                </div>
                            </div>
                        </div>

                        <!-- Divider -->
                        <div class="adm-header__divider" aria-hidden="true"></div>

                        <!-- Admin Profile -->
                        <div class="adm-dropdown" id="admProfileDropdown">
                            <button class="adm-profile-btn" id="admProfileTrigger" aria-haspopup="true" aria-expanded="false" aria-controls="admProfileMenu" title="Admin profile">
                                <span class="adm-avatar" id="admAvatar" aria-hidden="true">A</span>
                                <span class="adm-profile-name adm-btn-label" id="admProfileName">Admin</span>
                                <i class="fa-solid fa-chevron-down adm-caret" aria-hidden="true"></i>
                            </button>
                            <div class="adm-dropdown__menu adm-dropdown__menu--right" id="admProfileMenu" role="menu" aria-label="Admin profile menu">
                                <div class="adm-profile-card" id="admProfileCard">
                                    <span class="adm-avatar adm-avatar--lg" aria-hidden="true">A</span>
                                    <div>
                                        <div class="adm-profile-card__name" id="admProfileCardName">Administrator</div>
                                        <div class="adm-profile-card__role">System Admin</div>
                                    </div>
                                </div>
                                <div class="adm-dropdown__divider"></div>
                                <a href="index.html" target="_blank" class="adm-dropdown__item" role="menuitem">
                                    <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
                                    <div><span class="adm-dropdown__item-title">Live Site</span></div>
                                </a>
                                <button class="adm-dropdown__item adm-dropdown__item--danger" role="menuitem" id="admLogoutBtn">
                                    <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
                                    <div><span class="adm-dropdown__item-title">Logout</span></div>
                                </button>
                            </div>
                        </div>

                    </div><!-- /.adm-header__right -->
                </div><!-- /.adm-header__inner -->
            </header>
            <!-- ============== END ADMIN CONTROL BAR ============== -->

            <!-- Tab panes -->
            <div class="tab-content">

            <!-- 0. Dashboard -->
            <div role="tabpanel" class="tab-pane fade in active" id="dashboardAdmin" style="padding-bottom: 50px;">
                <div class="row">
                    <div class="col-md-12 text-center" style="margin-bottom: 40px;">
                        <h2 style="font-size: 38px; margin-top: 0; color: #D4AF37; font-weight: 700;">COMMAND CENTER</h2>
                        <p style="color: #888; font-size: 18px; letter-spacing: 1px;">CENTRAL MANAGEMENT PORTAL</p>
                        <hr style="width: 80px; border-top: 3px solid #D4AF37; margin: 25px auto;">
                    </div>
                </div>
                
                <div class="row" style="display: flex; flex-wrap: wrap; justify-content: center; gap: 20px; padding: 0 15px;">
                    <!-- Row 1 -->
                    <div class="dashboard-tile" onclick="switchTab('homeAdmin');">
                        <i class="fa-solid fa-images"></i>
                        <h4>Home Slider</h4>
                    </div>
                    
                    <div class="dashboard-tile" onclick="switchTab('aboutAdmin');">
                        <i class="fa-solid fa-user-astronaut"></i>
                        <h4>About Me</h4>
                    </div>
                    
                    <div class="dashboard-tile" onclick="switchTab('careerAdmin');">
                        <i class="fa-solid fa-star"></i>
                        <h4>Career Highlights</h4>
                    </div>

                    <div class="dashboard-tile" onclick="switchTab('galleryAdmin');">
                        <i class="fa-solid fa-image"></i>
                        <h4>Gallery</h4>
                    </div>

                    <!-- Row 2 -->
                    <div class="dashboard-tile" onclick="switchTab('socialAdmin');">
                        <i class="fa-solid fa-share-nodes"></i>
                        <h4>Social Media</h4>
                    </div>

                    <div class="dashboard-tile" onclick="switchTab('eventsAdmin');">
                        <i class="fa-regular fa-calendar-days"></i>
                        <h4>Upcoming Events</h4>
                    </div>  

                    <div class="dashboard-tile" onclick="switchTab('contactAdmin');">
                        <i class="fa-solid fa-address-book"></i>
                        <h4>Contact Me</h4>
                    </div>

                    <div class="dashboard-tile" onclick="switchTab('inquiriesAdmin');">
                        <i class="fa-solid fa-envelope-open-text"></i>
                        <h4>Inquiries</h4>
                    </div>                      

                    <!-- Row 3 -->
                    <div class="dashboard-tile" onclick="switchTab('bookingsAdmin');">
                        <i class="fa-solid fa-calendar-check"></i>
                        <h4>Bookings</h4>
                    </div>
                 
                    <div class="dashboard-tile" onclick="switchTab('calendarAdmin');">
                        <i class="fa-solid fa-calendar-days"></i>
                        <h4>Calendar</h4>
                    </div>                     

                    <div class="dashboard-tile" onclick="switchTab('financeAdmin');">
                        <i class="fa-solid fa-file-invoice-dollar"></i>
                        <h4>Finance</h4>
                    </div>

                    <div class="dashboard-tile" onclick="switchTab('newsletterAdmin');">
                        <i class="fa-solid fa-paper-plane"></i>
                        <h4>Newsletter</h4>
                    </div>

                    <!-- Row 4 -->
                    <div class="dashboard-tile" onclick="switchTab('emailLogsAdmin');">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                        <h4>System Logs</h4>
                    </div>
                    <div class="dashboard-tile" onclick="switchTab('securityAdmin');">
                        <i class="fa-solid fa-shield-halved"></i>
                        <h4>Security & Audit</h4>
                    </div>
                    <div class="dashboard-tile" onclick="switchTab('preferencesAdmin');">
                        <i class="fa-solid fa-paint-roller"></i>
                        <h4>Preferences</h4>
                    </div>

                    <div class="dashboard-tile" onclick="switchTab('usersAdmin');">
                        <i class="fa-solid fa-users-gear"></i>
                        <h4>User Management</h4>
                    </div>
                </div>

                <style>
                    .dashboard-tile {
                        flex: 1 1 calc(25% - 20px);
                        min-width: 180px;
                        max-width: 280px;
                        background: #111;
                        border: 1px solid #222;
                        border-radius: 12px;
                        padding: 40px 20px;
                        text-align: center;
                        cursor: pointer;
                        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                        margin-bottom: 5px;
                    }
                    .dashboard-tile:hover {
                        transform: translateY(-10px);
                        border-color: #D4AF37;
                        background: #151515;
                        box-shadow: 0 15px 30px rgba(212, 175, 55, 0.15);
                    }
                    .dashboard-tile i {
                        font-size: 38px;
                        color: #D4AF37;
                        margin-bottom: 20px;
                        transition: transform 0.3s ease;
                    }
                    .dashboard-tile:hover i {
                        transform: scale(1.1);
                    }
                    .dashboard-tile h4 {
                        margin: 0;
                        color: #fff;
                        font-size: 15px;
                        font-weight: 600;
                        letter-spacing: 0.5px;
                        text-transform: uppercase;
                    }
                    @media (max-width: 1199px) {
                        .dashboard-tile { flex: 1 1 calc(33.33% - 20px); }
                    }
                    @media (max-width: 767px) {
                        .dashboard-tile { flex: 1 1 calc(50% - 20px); }
                    }
                    @media (max-width: 480px) {
                        .dashboard-tile { flex: 1 1 100%; }
                    }
                </style>
                </div>
            </div>


            <!-- Users Tab — Enhanced User Management Module -->
            <div role="tabpanel" class="tab-pane fade" id="usersAdmin">
                <div class="um-shell">

                    <!-- Module Header -->
                    <div class="um-header">
                        <div>
                            <h2 class="um-page-title"><i class="fa-solid fa-users-gear"></i> User Management</h2>
                            <p class="um-page-sub">Manage administrative accounts, update your profile, and control access.</p>
                        </div>
                    </div>

                    <!-- Tab Navigation -->
                    <div class="um-tab-bar" role="tablist">
                        <button class="um-tab-btn active" data-um-tab="umPanelProfile" role="tab" aria-selected="true">
                            <i class="fa-regular fa-circle-user"></i> My Profile
                        </button>
                        <button class="um-tab-btn" data-um-tab="umPanelPassword" role="tab" aria-selected="false">
                            <i class="fa-solid fa-lock"></i> Change Password
                        </button>
                        <button class="um-tab-btn" data-um-tab="umPanelUsers" role="tab" aria-selected="false">
                            <i class="fa-solid fa-users"></i> Manage Users
                        </button>
                    </div>

