                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="qbAddItemBtn" style="color:#aaa; border-color:#444; margin-bottom:20px; background: transparent;"><i class="fa fa-plus"></i> Add Item</button>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group" style="margin-bottom:15px;">
                                <label style="color:#aaa;font-size:12px;">Notes / Terms</label>
                                <textarea class="form-control" id="quoteModalDetails" rows="4" style="background:#222;border:1px solid #444;color:#fff;" placeholder="Additional context, travel details, or payment terms.">50% Deposit required to secure the booking. Balance due 48 hours prior to the event.</textarea>
                            </div>
