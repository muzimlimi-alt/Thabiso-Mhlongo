                                    <label for="careerTitle">Event/Project Title</label>
                                    <input type="text" id="careerTitle" class="form-control" placeholder="e.g. One Man Special: 'Taxi Stories'" required>
                                </div>
                                <div class="form-group">
                                    <label for="careerBadge">Short Impact Label (Optional)</label>
                                    <input type="text" id="careerBadge" class="form-control" placeholder="e.g. Sold Out">
                                </div>
                                <div class="form-group">
                                    <label for="careerLocation">Location (Optional)</label>
