                                <div class="row">
                                    <div class="col-sm-5 text-center">
                                        <img id="previewAboutImg" class="img-responsive about-img" src="images/image-slider-1.jpg" alt="Preview" style="max-width:100%; height:auto; border-radius:5px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);">
                                    </div>
                                    <div class="col-sm-7" style="color:#333;">
                                        <p class="lead" id="previewAboutP1" style="font-size:18px; margin-bottom:15px; font-weight:300;"><em>No lead text provided yet.</em></p>
                                        <p id="previewAboutP2" style="margin-bottom:10px;"></p>
                                        <p id="previewAboutP3"></p>
