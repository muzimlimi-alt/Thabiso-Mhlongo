                                <form id="eventsForm" class="um-form" autocomplete="off">
                                    <div class="form-group" style="display: none;" id="eventVideoWarning">
                                        <div class="alert alert-warning" style="padding: 10px; font-size: 12px; margin-bottom: 10px;">
                                            <strong>Video Upload Error!</strong><br>You cannot upload local videos. Please paste a YouTube/Vimeo URL below.
                                        </div>
                                    </div>

                                    <div class="um-field-group">
                                        <label class="um-label">Event Title</label>
                                        <div class="um-input-wrap">
                                            <i class="fa-solid fa-heading um-input-icon"></i>
                                            <input type="text" id="eventsTitle" class="um-input" placeholder="e.g. Soweto Comedy Festival" required>
                                        </div>
                                    </div>

                                    <div class="um-field-group">
                                        <label class="um-label">Event Description</label>
                                        <textarea id="eventsDesc" class="um-input" placeholder="Short description..." rows="3" style="resize: vertical;"></textarea>
                                    </div>

                                    <div class="um-field-group">
                                        <label class="um-label">Event Poster Upload</label>
                                        <div class="um-input-wrap">
                                            <i class="fa-solid fa-image um-input-icon"></i>
                                            <input type="file" id="eventsFile" class="um-input" accept="image/*" style="padding: 8px;">
                                        </div>
                                    </div>

                                    <div class="um-field-group">
                                        <label class="um-label">Ticket Sales Link</label>
                                        <div class="um-input-wrap">
                                            <i class="fa-solid fa-ticket um-input-icon"></i>
                                            <input type="url" id="eventsTicketUrl" class="um-input" placeholder="https://webtickets.co.za/...">
                                        </div>
                                    </div>

                                    <div class="um-form-grid">
                                        <div class="um-field-group">
                                            <label class="um-label">Date and Time</label>
                                            <div class="um-input-wrap">
                                                <i class="fa-regular fa-clock um-input-icon"></i>
                                                <input type="text" id="eventsDate" class="um-input" placeholder="Select Date/Time" required>
                                            </div>
                                        </div>
                                        <div class="um-field-group">
                                            <label class="um-label">Venue Name</label>
                                            <div class="um-input-wrap">
                                                <i class="fa-solid fa-location-dot um-input-icon"></i>
                                                <input type="text" id="eventsVenue" class="um-input" placeholder="The Grand Theatre" required>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="um-field-group">
                                        <label class="um-label">Venue Search (Google Maps)</label>
                                        <div class="um-input-wrap">
                                            <i class="fa-solid fa-magnifying-glass-location um-input-icon"></i>
                                            <input type="text" id="eventsVenueSearch" class="um-input" placeholder="Search for a location...">
                                        </div>
                                    </div>

                                    <div class="um-field-group">
                                        <label class="um-label">Map URL / Pin</label>
                                        <div class="um-input-wrap">
                                            <i class="fa-solid fa-map-location-dot um-input-icon"></i>
                                            <input type="url" id="eventsVenueMapLink" class="um-input" placeholder="https://maps.google.com/...">
                                        </div>
                                    </div>

                                    <!-- Hidden fields -->
                                    <input type="hidden" id="eventsId">
                                    <input type="hidden" id="eventsFallbackUrl">

                                    <div class="um-form-actions">
                                        <button type="submit" class="um-btn um-btn--primary" id="eventsSubmitBtn">
                                            <i class="fa-solid fa-calendar-check"></i> Add Event
                                        </button>
                                        <button type="button" class="um-btn um-btn--ghost" onclick="$('#eventsForm')[0].reset(); $('#eventsId').val(''); $('#eventsSubmitBtn').html('<i class=\'fa-solid fa-calendar-check\'></i> Add Event');">
                                            Cancel
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>

