    <strong><i class="fa fa-bars" style="margin-right:8px; color:#aaa;"></i>Manager Details</strong> <i class="fa fa-chevron-down" style="color: #aaa;"></i>
</div>
                            <div id="collapseManagerForm" class="collapse" style="margin-top: 15px;">
