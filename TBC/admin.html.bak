                         PANEL 3: MANAGE USERS
                    ============================================================ -->
                    <div class="um-panel" id="umPanelUsers">
                        <div class="um-section-card">
                            <!-- Panel header row -->
                            <div class="um-panel-toprow">
                                <div>
