                                                <th style="border: none; color:#777; font-size:12px; text-transform:uppercase; letter-spacing:0.5px; font-weight:600;">Date</th>
                                                <th style="border: none; color:#777; font-size:12px; text-transform:uppercase; letter-spacing:0.5px; font-weight:600;">Status</th>
                                                <th style="border: none; color:#777; font-size:12px; text-transform:uppercase; letter-spacing:0.5px; font-weight:600; text-align: right;">Actions</th>
                                            </tr>
                                        </thead>
