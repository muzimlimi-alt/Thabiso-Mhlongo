                                            <!-- Javascript will inject subscribers here dynamically -->
                                        </tbody>
                                    </table>

                                    <div id="subscriberListEmpty" class="text-muted text-center" style="font-size: 12px; padding: 20px 0; display: none;">No subscribers found.</div>
