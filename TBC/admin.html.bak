            <div role="tabpanel" class="tab-pane fade" id="calendarAdmin">
                <div class="um-shell">
                    <!-- Module Header -->
                    <div class="um-header">
                        <div style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
                            <div>
                                <h2 class="um-page-title"><i class="fa-solid fa-calendar-days"></i> Unified Calendar</h2>
                                <p class="um-page-sub">Command center for all bookings, holds, and events.</p>
                            </div>
                            <button class="um-btn um-btn--primary" id="btnNewDateHold">
                                <i class="fa fa-plus"></i> Block Out Dates
                            </button>
                        </div>
                    </div>

                    <div class="um-panel active">
                        <div class="row">
                            <!-- Main Calendar Column -->
                            <div class="col-lg-8">
                                <div class="um-section-card" style="min-height: 800px;">
                                    <div id="calendar" style="min-height: 700px;"></div>
                                    
                                    <div class="calendar-legend" style="margin-top: 25px; padding: 15px; background: rgba(0,0,0,0.2); border-radius: 8px; border: 1px solid #333; display: flex; gap: 20px; flex-wrap: wrap;">
                                        <div style="display:flex; align-items:center; gap:8px;"><span style="width:10px; height:10px; border-radius:50%; background:#D4AF37;"></span> <span style="font-size:12px; color:#aaa;">Confirmed Booking</span></div>
                                        <div style="display:flex; align-items:center; gap:8px;"><span style="width:10px; height:10px; border-radius:50%; background:#777;"></span> <span style="font-size:12px; color:#aaa;">Manual Hold / Block</span></div>
                                        <div style="display:flex; align-items:center; gap:8px;"><span style="width:10px; height:10px; border-radius:50%; background:#17a2b8;"></span> <span style="font-size:12px; color:#aaa;">Public Event</span></div>
                                        <div style="display:flex; align-items:center; gap:8px;"><span style="width:10px; height:10px; border-radius:50%; background:#444;"></span> <span style="font-size:12px; color:#aaa;">Pending Inquiry</span></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Sidebar Column -->
                            <div class="col-lg-4">
                                <div class="um-section-card" style="height: 100%;">
                                    <!-- Mini Calendar Section -->
                                    <div class="mini-calendar" id="miniCalendarContainer">
                                        <h3 class="um-section-label" style="font-size: 16px;"><i class="fa-solid fa-calendar-day"></i> NAVIGATION</h3>
                                        <div class="mini-calendar-header" style="margin-top: 15px;">
                                            <button class="change-btn" id="prevMiniMonth"><i class="fa-solid fa-chevron-left"></i></button>
                                            <div class="month-year" id="miniMonthYearDisplay" style="color: #D4AF37; font-weight: 600;">Loading...</div>
                                            <button class="change-btn" id="nextMiniMonth"><i class="fa-solid fa-chevron-right"></i></button>
                                        </div>
                                        <table class="mini-calendar-table">
                                            <thead>
                                                <tr>
                                                    <th>S</th><th>M</th><th>T</th><th>W</th><th>T</th><th>F</th><th>S</th>
                                                </tr>
                                            </thead>
                                            <tbody id="miniCalendarBody">
                                                <!-- Will be generated by JS -->
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="um-divider"></div>

                                    <!-- Working Schedule Section -->
                                    <div class="working-schedule">
                                        <h3 class="um-section-label" style="font-size: 16px;"><i class="fa-solid fa-clock"></i> UPCOMING EVENTS</h3>
                                        <div id="workingScheduleContent" style="margin-top: 15px;">
                                            <ul class="working-schedule-list" id="upcomingScheduleList">
                                                <li style="color: #666; padding: 20px; text-align: center;">Loading upcoming events...</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Finance Tab -->
            <div role="tabpanel" class="tab-pane fade" id="financeAdmin">
                <div class="row">
                    <div class="col-md-12">
                        <div class="admin-card">
                            <div class="row" style="margin-bottom: 20px;">
                                <div class="col-md-6">
                                    <h2 style="margin: 0;"><i class="fa-solid fa-hand-holding-dollar"></i> Financial Ledger</h2>
                                    <p class="text-muted">Track revenue, pending payments, and invoices.</p>
                                </div>
                                <div class="col-md-6 text-right">
                                    <a href="/api/admin/finance/export" class="btn btn-admin-secondary" style="margin-right: 10px;">
                                        <i class="fa-solid fa-file-csv"></i> Download CSV
                                    </a>
                                    <button class="btn btn-admin-primary" onclick="loadFinancialStats()">
                                        <i class="fa-solid fa-rotate-right"></i> Refresh Stats
                                    </button>
                                </div>
                            </div>

                            <!-- Financial Summary Cards -->
                            <div class="row" style="margin-bottom: 30px;">
                                <div class="col-md-4">
                                    <div class="finance-stat-card" style="background: rgba(76,175,80,0.1); border: 1px solid rgba(76,175,80,0.2); padding: 20px; border-radius: 12px; text-align: center;">
                                        <div style="color: #4CAF50; font-size: 13px; font-weight: bold; text-transform: uppercase;">Total Revenue</div>
                                        <div id="finStat-TotalRevenue" style="font-size: 28px; font-weight: bold; color: #fff; margin: 10px 0;">R 0.00</div>
                                        <div class="text-muted small">Validated Payments Received</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="finance-stat-card" style="background: rgba(255,152,0,0.1); border: 1px solid rgba(255,152,0,0.2); padding: 20px; border-radius: 12px; text-align: center;">
                                        <div style="color: #FF9800; font-size: 13px; font-weight: bold; text-transform: uppercase;">Outstanding</div>
                                        <div id="finStat-Outstanding" style="font-size: 28px; font-weight: bold; color: #fff; margin: 10px 0;">R 0.00</div>
                                        <div class="text-muted small">Invoiced but Unpaid</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="finance-stat-card" style="background: rgba(33,150,243,0.1); border: 1px solid rgba(33,150,243,0.2); padding: 20px; border-radius: 12px; text-align: center;">
                                        <div style="color: #2196F3; font-size: 13px; font-weight: bold; text-transform: uppercase;">Pending Quotes</div>
                                        <div id="finStat-Pending" style="font-size: 28px; font-weight: bold; color: #fff; margin: 10px 0;">R 0.00</div>
                                        <div class="text-muted small">Awaiting Client Approval</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Tabs for Invoices vs Transactions -->
                            <ul class="nav nav-tabs" role="tablist" style="border-bottom-color: #333;">
                                <li role="presentation" class="active"><a href="#finTransactions" aria-controls="finTransactions" role="tab" data-toggle="tab">Recent Transactions</a></li>
                                <li role="presentation"><a href="#finInvoices" aria-controls="finInvoices" role="tab" data-toggle="tab">All Invoices</a></li>
                            </ul>

                            <div class="tab-content" style="padding-top: 20px;">
                                <div role="tabpanel" class="tab-pane active" id="finTransactions">
                                    <div class="table-responsive">
                                        <table class="table" style="color: #eee; border-color: #333;">
                                            <thead>
                                                <tr style="color: #D4AF37;">
                                                    <th>Date</th>
                                                    <th>Reference</th>
                                                    <th>Client / Booking</th>
                                                    <th>Method</th>
                                                    <th>Amount</th>
                                                    <th>Status</th>
                                                </tr>
                                            </thead>
                                            <tbody id="finTransactionsList">
                                                <tr><td colspan="6" class="text-center">Loading transactions...</td></tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                <div role="tabpanel" class="tab-pane" id="finInvoices">
                                    <div class="table-responsive">
                                        <table class="table" style="color: #eee; border-color: #333;">
                                            <thead>
                                                <tr style="color: #D4AF37;">
                                                    <th>Invoice #</th>
                                                    <th>Date</th>
                                                    <th>Client</th>
                                                    <th>Total</th>
                                                    <th>Status</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody id="finInvoicesList">
                                                <tr><td colspan="6" class="text-center">Loading invoices...</td></tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Booking Details & Responder Modal -->
            <div class="modal fade" id="adminBookingModal" tabindex="-1" role="dialog" aria-labelledby="adminBookingModalLabel">
                <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-content" style="border-radius: 6px;">
                        <div class="modal-header" style="background-color: #222; color: #D4AF37; border-top-left-radius: 6px; border-top-right-radius: 6px;">
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="color: #fff; opacity: 1;"><span aria-hidden="true">&times;</span></button>
                            <h4 class="modal-title" id="adminBookingModalLabel">Booking Request Details</h4>
                        </div>
                        <div class="modal-body" style="background-color: #111; color: #ddd; padding: 0;">
                            <div class="row" style="margin: 0;">
                                <!-- Details Column -->
                                <div class="col-md-5" style="padding: 20px; background-color: #1a1a1a; border-right: 1px solid #333; height: 100%;">
                                    <h5 style="margin-top: 0; color: #D4AF37; text-transform: uppercase; font-size: 14px; font-weight: bold; letter-spacing: 1.5px; border-bottom: 1px solid #333; padding-bottom: 5px; margin-bottom: 10px;">Client Info</h5>
                                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px; font-size: 14px; padding-left: 10px; display: block;">
                                        <tr><td style="padding: 6px 0; width: 120px; vertical-align: top; color:#aaa;"><strong>Name:</strong></td><td style="padding: 6px 0; vertical-align: top;"><span id="abName" style="color: #fff;"></span></td></tr>
                                        <tr><td style="padding: 6px 0; vertical-align: top; color:#aaa;"><strong>Company:</strong></td><td style="padding: 6px 0; vertical-align: top;"><span id="abCompany" style="color: #fff;"></span></td></tr>
                                        <tr><td style="padding: 6px 0; vertical-align: top; color:#aaa;"><strong>Email:</strong></td><td style="padding: 6px 0; vertical-align: top;"><a href="#" id="abEmail" style="color: #D4AF37;"></a></td></tr>
                                        <tr><td style="padding: 6px 0; vertical-align: top; color:#aaa;"><strong>Phone:</strong></td><td style="padding: 6px 0; vertical-align: top;"><span id="abCell" style="color: #fff;"></span></td></tr>
                                    </table>

                                    <h5 style="color: #D4AF37; text-transform: uppercase; font-size: 14px; font-weight: bold; letter-spacing: 1.5px; border-bottom: 1px solid #333; padding-bottom: 5px; margin-bottom: 10px;">Event Details</h5>
                                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px; font-size: 14px; padding-left: 10px; display: block;">
                                        <tr><td style="padding: 6px 0; width: 120px; vertical-align: top; color:#aaa;"><strong>Event Name:</strong></td><td style="padding: 6px 0; vertical-align: top;"><span id="abEventName" style="color: #fff;"></span></td></tr>
                                        <tr><td style="padding: 6px 0; vertical-align: top; color:#aaa;"><strong>Date & Time:</strong></td><td style="padding: 6px 0; vertical-align: top;"><span id="abDate" style="color: #f0ad4e; font-weight: bold;"></span> <span id="abStartTime" style="color: #fff;"></span></td></tr>
                                        <tr><td style="padding: 6px 0; vertical-align: top; color:#aaa;"><strong>Perf. Slot:</strong></td><td style="padding: 6px 0; vertical-align: top;"><span id="abSlot" style="color: #fff;"></span></td></tr>
                                        <tr><td style="padding: 6px 0; vertical-align: top; color:#aaa;"><strong>Duration:</strong></td><td style="padding: 6px 0; vertical-align: top;"><span id="abDuration" style="color: #fff;"></span></td></tr>
                                        <tr><td style="padding: 6px 0; vertical-align: top; color:#aaa;"><strong>Location Name:</strong></td><td style="padding: 6px 0; vertical-align: top;"><span id="abLocation" style="color: #fff;"></span></td></tr>
                                        <tr><td style="padding: 6px 0; vertical-align: top; color:#aaa;"><strong>Address:</strong></td><td style="padding: 6px 0; vertical-align: top;"><span id="abAddress" style="color: #fff;"></span></td></tr>
                                        <tr><td style="padding: 6px 0; vertical-align: top; color:#aaa;"><strong>Event Type:</strong></td><td style="padding: 6px 0; vertical-align: top;"><span id="abType" class="label label-warning" style="background-color: #D4AF37; color: #111;"></span></td></tr>
                                        <tr><td style="padding: 6px 0; vertical-align: top; color:#aaa;"><strong>Venue Type:</strong></td><td style="padding: 6px 0; vertical-align: top;"><span id="abVenueType" style="color: #fff;"></span></td></tr>
                                    </table>
                                    
                                    <h5 style="color: #D4AF37; text-transform: uppercase; font-size: 14px; font-weight: bold; letter-spacing: 1.5px; border-bottom: 1px solid #333; padding-bottom: 5px; margin-bottom: 10px;">Audience & Logistics</h5>
                                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px; font-size: 14px; padding-left: 10px; display: block;">
                                        <tr><td style="padding: 6px 0; width: 120px; vertical-align: top; color:#aaa;"><strong>Audience Size:</strong></td><td style="padding: 6px 0; vertical-align: top;"><span id="abAudience" style="color: #fff;"></span></td></tr>
                                        <tr><td style="padding: 6px 0; vertical-align: top; color:#aaa;"><strong>Demographic:</strong></td><td style="padding: 6px 0; vertical-align: top;"><span id="abDemographic" style="color: #fff;"></span></td></tr>
                                        <tr><td style="padding: 6px 0; vertical-align: top; color:#aaa;"><strong>Travel Provided:</strong></td><td style="padding: 6px 0; vertical-align: top;"><span id="abTravel" style="color: #fff;"></span></td></tr>
                                        <tr><td style="padding: 6px 0; vertical-align: top; color:#aaa;"><strong>Budget:</strong></td><td style="padding: 6px 0; vertical-align: top;"><span id="abBudget" style="color: #5cb85c; font-weight: bold;"></span></td></tr>
                                    </table>

                                    <h5 style="color: #D4AF37; text-transform: uppercase; font-size: 14px; font-weight: bold; letter-spacing: 1.5px; border-bottom: 1px solid #333; padding-bottom: 5px; margin-bottom: 10px;">Notes</h5>
                                    <div id="abMessage" style="background-color: #222; color: #fff; padding: 10px; border: 1px solid #333; border-radius: 4px; font-size: 13px; white-space: pre-wrap; max-height: 150px; overflow-y: auto;"></div>
                                </div>

                                <!-- Responder Column -->
                                <div class="col-md-7" style="padding: 20px;">
                                    <form id="adminRespondForm">
                                        <input type="hidden" id="respondBookingId">
                                        <input type="hidden" id="respondBookingEmail">
                                        
                                        <div class="row" style="margin-bottom: 15px;">
                                            <div class="col-xs-6">
                                                <h5 style="margin: 0; color: #D4AF37; text-transform: uppercase; font-size: 12px; font-weight: bold; letter-spacing: 1px; line-height: 30px;">Email Client</h5>
                                            </div>
                                            <div class="col-xs-6 text-right">
                                                <select id="emailTemplate" class="form-control input-sm" style="display: inline-block; width: 100%; background-color: #222; color: #fff; border: 1px solid #444;">
                                                    <option value="" disabled selected>Load Template...</option>
                                                    <option value="pricing">Send Pricing List</option>
                                                    <option value="available">Confirm Availability</option>
                                                    <option value="decline">Unavailable / Decline</option>
                                                    <option value="call">Request Phone Call</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label style="color: #ddd;">Subject</label>
                                            <input type="text" id="respondSubject" class="form-control" style="background-color: #222; color: #fff; border: 1px solid #444;" required>
                                        </div>

                                        <div class="form-group">
                                            <label style="color: #ddd;">Message</label>
                                            <textarea id="respondMessage" class="form-control" rows="10" style="font-family: inherit; background-color: #222; color: #fff; border: 1px solid #444;" required></textarea>
                                        </div>

                                        <div id="respondAlert" class="alert" style="display: none; padding: 10px;"></div>

                                        <div class="text-right">
                                            <button type="button" class="btn btn-admin-secondary" data-dismiss="modal">Close</button>
                                            <button type="submit" id="respondSubmitBtn" class="btn " style="background-color: #D4AF37; color: #111; font-weight: bold; border-color: #D4AF37;">
                                                <i class="fa-solid fa-paper-plane" style="margin-right: 5px;"></i> Send & Mark Responded
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 1. Home Slider -->
            <div role="tabpanel" class="tab-pane fade" id="homeAdmin">
                <div class="row">
                    <div class="col-md-6">
                        <div class="admin-card">
                            <h2>Manage Home Slider</h2>
                            <p class="text-muted">Upload high-resolution images for the top carousel.</p><hr>
                            <form id="homeForm">
                                <div class="form-group">
                                    <label for="homeFile">Upload Local Image(s)</label>
                                    <input type="file" id="homeFile" class="form-control" accept="image/*" multiple>
                                    <small class="help-block text-danger" id="homeVideoWarning" style="display:none;">Videos cannot be uploaded directly. Please use the Web URL field below for videos.</small>
                                    <small class="help-block text-info">Images will be resized and compressed automatically to max 1200px width.</small>
                                </div>
                                <div style="text-align: center; margin: 15px 0; color: #777;">&mdash; OR &mdash;</div>
                                <div class="form-group">
                                    <label for="homeUrl">Web URL</label>
                                    <input type="text" id="homeUrl" class="form-control" placeholder="e.g. images/image-slider-2.jpg">
                                </div>
                                <div class="form-group">
                                    <label for="homeAlt">Alt Text (Optional)</label>
                                    <input type="text" class="form-control" id="homeAlt" placeholder="Applied to all if multiple files selected">
                                </div>
                                <div class="form-group">
                                    <label for="homeUploaderName">Uploader Name</label>
                                    <input type="text" class="form-control" id="homeUploaderName" placeholder="e.g. Thabiso or Admin" required>
                                </div>
                                <div class="form-group">
                                    <label for="homeLocation">Location (Optional)</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" id="homeLocation" placeholder="e.g. Constitutional Hill, Johannesburg">
                                        <span class="input-group-btn">
                                            <button class="btn btn-admin-secondary" type="button" id="btnHomeGps" title="Get GPS Location">
                                                <span class="glyphicon glyphicon-map-marker"></span> GPS
                                            </button>
                                        </span>
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-block btn-admin-primary" id="homeSubmitBtn">Add to Slider</button>
                            </form>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="admin-card">
                            <h2>Current Slider Items</h2>
                            <p class="text-muted">Images that are currently in your top carousel.</p><hr>
                            <div id="adminHomeList">
                                <!-- JS injected -->
                            </div>
                            <button id="clearHomeBtn" class="btn btn-sm btn-admin-danger" style="margin-top:10px; display:none;">Clear All Slider Images</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. About Me -->
            <div role="tabpanel" class="tab-pane fade" id="aboutAdmin">
                <div class="row">
                    <div class="col-md-5">
                        <div class="admin-card">
                            <h2>About Me Content</h2>
<p class="text-muted">Update your profile picture and biography.</p><hr>
<div data-toggle="collapse" data-target="#collapseAboutForm" style="cursor: pointer; display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.05); padding: 10px; border-radius: 4px; border: 1px solid #333; margin-bottom: 15px; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.1)'" onmouseout="this.style.background='rgba(255,255,255,0.05)'">
    <strong><i class="fa fa-bars" style="margin-right:8px; color:#aaa;"></i>Manage About Me Content</strong> <i class="fa fa-chevron-down" style="color: #aaa;"></i>
</div>
                            <div id="collapseAboutForm" class="collapse" style="margin-top: 15px;">
                                <form id="aboutForm">
                                <div class="form-group">
                                    <label for="aboutFile">Profile Photo (Upload)</label>
                                    <input type="file" id="aboutFile" class="form-control" accept="image/*">
                                    <small class="help-block text-danger" id="aboutVideoWarning" style="display:none;">Videos are not supported here. Please upload an image.</small>
                                    <small class="help-block text-info">Will scale automatically. Recommended square ratio.</small>
                                </div>
                                <div style="text-align: center; margin: 15px 0; color: #777;">&mdash; OR &mdash;</div>
                                <div class="form-group">
                                    <label for="aboutUrl">Web URL Fallback</label>
                                    <input type="text" id="aboutUrl" class="form-control" placeholder="e.g. images/image-slider-1.jpg">
                                </div>
                                <div class="form-group">
                                    <label for="aboutP1">Paragraph 1 (Lead)</label>
                                    <textarea id="aboutP1" class="form-control" rows="5" placeholder="<strong>Thabiso Mhlongo</strong> is a professional..." required></textarea>
                                </div>
                                <div class="form-group">
                                    <label for="aboutP2">Paragraph 2</label>
                                    <textarea id="aboutP2" class="form-control" rows="5" placeholder="Since starting his professional journey..."></textarea>
                                </div>
                                <div class="form-group">
                                    <label for="aboutP3">Paragraph 3</label>
                                    <textarea id="aboutP3" class="form-control" rows="5" placeholder="Known for his alternative..."></textarea>
                                </div>
                                <button type="submit" class="btn btn-block btn-admin-primary" id="aboutSubmitBtn">Update</button>
                                </form>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-7">
                        <div class="admin-card">
                            <h2>Live Preview</h2>
<p class="text-muted">This is how your About section will currently look.</p><hr>
<div data-toggle="collapse" data-target="#collapseAboutPreview" style="cursor: pointer; display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.05); padding: 10px; border-radius: 4px; border: 1px solid #333; margin-bottom: 15px; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.1)'" onmouseout="this.style.background='rgba(255,255,255,0.05)'">
    <strong><i class="fa fa-bars" style="margin-right:8px; color:#aaa;"></i>Live Preview</strong> <i class="fa fa-chevron-down" style="color: #aaa;"></i>
</div>
                            <div id="collapseAboutPreview" class="collapse in" style="margin-top: 15px;">
