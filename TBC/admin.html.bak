                            <form id="umProfileForm" class="um-form" autocomplete="off">
                                <input type="hidden" id="umMyUserId">
                                <div class="um-form-grid">
                                    <div class="um-field-group">
                                        <label class="um-label" for="umMyUsername">Username</label>
                                        <div class="um-input-wrap">
                                            <i class="fa-regular fa-user um-input-icon"></i>
                                            <input type="text" class="um-input" id="umMyUsername" placeholder="Enter username" required autocomplete="off">
                                        </div>
                                    </div>
                                    <div class="um-field-group">
                                        <label class="um-label" for="umMyEmail">Email Address</label>
                                        <div class="um-input-wrap">
                                            <i class="fa-regular fa-envelope um-input-icon"></i>
                                            <input type="email" class="um-input" id="umMyEmail" placeholder="Enter email address" required autocomplete="off">
                                        </div>
                                    </div>
                                </div>
                                <div class="um-form-actions">
                                    <button type="submit" class="um-btn um-btn--primary" id="umProfileSaveBtn">
                                        <i class="fa-solid fa-floppy-disk"></i> Save Profile
                                    </button>
                                    <button type="button" class="um-btn um-btn--ghost" id="umProfileResetBtn">
                                        <i class="fa-solid fa-rotate-left"></i> Reset
                                    </button>
                                </div>
                                <div class="um-feedback" id="umProfileFeedback" role="status" aria-live="polite"></div>
                            </form>
                        </div>
                    </div>

                    <!-- ============================================================
                         PANEL 2: CHANGE PASSWORD
                    ============================================================ -->
                    <div class="um-panel" id="umPanelPassword">
                        <div class="um-section-card">

                            <div class="um-icon-header">
                                <div class="um-icon-header__icon"><i class="fa-solid fa-lock-open"></i></div>
                                <div>
                                    <h4 class="um-section-label" style="margin-bottom:4px;">Change Password</h4>
                                    <p class="um-section-desc">Keep your admin account secure with a strong password.</p>
                                </div>
                            </div>

                            <div class="um-divider"></div>

                            <form id="umPasswordForm" class="um-form" autocomplete="off">

                                <!-- Current password -->
                                <div class="um-field-group">
                                    <label class="um-label" for="umCurrentPwd">Current Password</label>
                                    <div class="um-input-wrap">
                                        <i class="fa-solid fa-key um-input-icon"></i>
                                        <input type="password" class="um-input" id="umCurrentPwd" placeholder="Enter your current password" autocomplete="current-password" required>
                                        <button type="button" class="um-eye-btn" data-target="umCurrentPwd" aria-label="Toggle visibility"><i class="fa-regular fa-eye"></i></button>
                                    </div>
                                </div>

                                <!-- New password -->
                                <div class="um-field-group">
                                    <label class="um-label" for="umNewPwd">New Password</label>
                                    <div class="um-input-wrap">
                                        <i class="fa-solid fa-lock um-input-icon"></i>
                                        <input type="password" class="um-input" id="umNewPwd" placeholder="Enter a new password" autocomplete="new-password" required>
                                        <button type="button" class="um-eye-btn" data-target="umNewPwd" aria-label="Toggle visibility"><i class="fa-regular fa-eye"></i></button>
                                    </div>
                                    <!-- Strength meter -->
                                    <div class="um-strength-wrap">
                                        <div class="um-strength-bar">
                                            <span class="um-strength-seg" id="umSeg1"></span>
                                            <span class="um-strength-seg" id="umSeg2"></span>
                                            <span class="um-strength-seg" id="umSeg3"></span>
                                            <span class="um-strength-seg" id="umSeg4"></span>
                                        </div>
                                        <span class="um-strength-label" id="umStrengthLabel">Enter a new password</span>
                                    </div>
                                </div>

                                <!-- Confirm password -->
                                <div class="um-field-group">
                                    <label class="um-label" for="umConfirmPwd">Confirm New Password</label>
                                    <div class="um-input-wrap">
                                        <i class="fa-solid fa-check-double um-input-icon"></i>
                                        <input type="password" class="um-input" id="umConfirmPwd" placeholder="Re-enter new password" autocomplete="new-password" required>
                                        <button type="button" class="um-eye-btn" data-target="umConfirmPwd" aria-label="Toggle visibility"><i class="fa-regular fa-eye"></i></button>
                                    </div>
                                    <span class="um-match-hint" id="umMatchHint"></span>
                                </div>

                                <div class="um-security-tips">
                                    <i class="fa-solid fa-circle-info"></i>
                                    <ul>
                                        <li>Use at least 8 characters.</li>
                                        <li>Mix uppercase, lowercase, numbers, and symbols.</li>
                                        <li>Avoid using your username as your password.</li>
                                    </ul>
                                </div>

                                <div class="um-form-actions">
                                    <button type="submit" class="um-btn um-btn--primary">
                                        <i class="fa-solid fa-shield-halved"></i> Update Password
                                    </button>
                                    <button type="reset" class="um-btn um-btn--ghost">
                                        <i class="fa-solid fa-xmark"></i> Clear
                                    </button>
                                </div>
                                <div class="um-feedback" id="umPasswordFeedback" role="status" aria-live="polite"></div>
                            </form>
                        </div>
                    </div>

