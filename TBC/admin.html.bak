			<div class="modal-footer" style="background:#0e0e0e;border-top:1px solid #2a2a2a;display:flex;justify-content:space-between;align-items:center;padding:14px 24px;">
				<small style="color:#555;">Thabiso Mhlongo &mdash; bookings@thabisomhlongo.com</small>
