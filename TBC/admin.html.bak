                                </div>
                                <div style="text-align: center; margin: 15px 0; color: #777;">&mdash; OR &mdash;</div>
                                <div class="form-group">
                                    <label for="careerUrl">Web URL Fallback (For YouTube/Images)</label>
                                    <input type="text" id="careerUrl" class="form-control" placeholder="e.g. https://www.youtube.com/watch?v=...">
