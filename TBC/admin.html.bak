                                    <div class="um-input-wrap">
                                        <i class="fa-solid fa-magnifying-glass um-input-icon"></i>
                                        <input type="text" id="subscriberSearch" class="um-input" placeholder="Search by email..." />
                                    </div>
                                </div>

                                <div style="background: rgba(255,255,255,0.03); border: 1px solid #252525; border-radius: 10px; padding: 15px; max-height: 500px; overflow-y: auto;">
                                    <h4 style="margin-top: 0; font-size: 13px; color: #777; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; border-bottom: 1px solid #252525; padding-bottom: 10px; margin-bottom: 15px;">
                                        <span id="subscriberCount" style="font-size: 22px; color: #D4AF37; font-weight: 700; text-transform: none; letter-spacing: 0;">0</span> Total Subscribers
                                    </h4>

