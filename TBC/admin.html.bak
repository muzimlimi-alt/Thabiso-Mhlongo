            <!-- 9. Email Logs -->
            <div role="tabpanel" class="tab-pane fade" id="emailLogsAdmin">
                <div class="um-shell">
                    <div class="um-header">
                        <div>
                            <h2 class="um-page-title"><i class="fa-solid fa-list-check"></i> Email Delivery Logs</h2>
                            <p class="um-page-sub">Monitor all outgoing system communications, delivery status, and error reports.</p>
                        </div>
                        <div class="um-header-actions">
                            <button class="um-btn um-btn--ghost" onclick="loadEmailLogs()">
                                <i class="fa-solid fa-rotate"></i> Refresh Logs
                            </button>
                        </div>
                    </div>

                    <div class="um-section-card">
                        <div class="um-panel-toprow">
                            <div>
                                <h4 class="um-section-label">Communication History</h4>
                                <p class="um-section-desc">Search, filter and track all system communications.</p>
                            </div>
                        </div>

                        <!-- ADVANCED CONTROLS (Search, Filter, Sort) -->
                        <div class="um-logs-controls" style="display:flex; flex-wrap:wrap; gap:15px; margin: 20px 0; background: rgba(255,255,255,0.02); padding: 15px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.05);">
                            <div style="flex:1; min-width: 250px; position:relative;">
                                <i class="fa-solid fa-search" style="position:absolute; left:12px; top:50%; transform:translateY(-50%); color:#D4AF37; opacity:0.6;"></i>
                                <input type="text" id="logSearch" placeholder="Search by recipient or subject..." class="um-input" style="padding-left:35px; width:100%;" oninput="debounceLogSearch()">
                            </div>
                            <div style="width: 160px;">
                                <select id="logStatusFilter" class="um-input" onchange="applyLogFilters()">
                                    <option value="">All Statuses</option>
                                    <option value="success">Success</option>
                                    <option value="failed">Failed</option>
                                    <option value="pending">Pending</option>
                                </select>
                            </div>
                            <div style="width: 200px;">
                                <select id="logTriggerFilter" class="um-input" onchange="applyLogFilters()">
                                    <option value="">All Events</option>
                                    <option value="Booking: Admin Notification">New Booking</option>
                                    <option value="Booking: Formal Quote">Sent Quote</option>
                                    <option value="Booking: Payment Received">Payment Received</option>
                                    <option value="Contact Form: Admin Notification">Contact Inquiry</option>
                                    <option value="Newsletter: Campaign Dispatch">Newsletter Campaign</option>
                                    <option value="Admin: Direct Compose">Admin Direct Message</option>
                                    <option value="Admin: Password Reset Request">Password Reset</option>
                                </select>
                            </div>
                        </div>
                        <div class="um-divider"></div>
                        
                        <div class="table-responsive" style="margin-top: 20px;">
                            <table class="table" style="color: #eee; background: transparent; border-collapse: separate; border-spacing: 0 8px; width: 100%;">
                                <thead id="logSortHeaders">
                                    <tr style="border-bottom: 2px solid #333;">
                                        <th style="border:none; padding: 12px; color: #D4AF37; cursor:pointer;" onclick="toggleLogSort('sent_at')">
                                            Timestamp <i class="fa-solid fa-sort" id="sort-sent_at" style="font-size:10px; margin-left:5px; opacity:0.5;"></i>
                                        </th>
                                        <th style="border:none; padding: 12px; color: #D4AF37; cursor:pointer;" onclick="toggleLogSort('recipient_email')">
                                            Recipient <i class="fa-solid fa-sort" id="sort-recipient_email" style="font-size:10px; margin-left:5px; opacity:0.5;"></i>
                                        </th>
                                        <th style="border:none; padding: 12px; color: #D4AF37; cursor:pointer;" onclick="toggleLogSort('subject')">
                                            Subject <i class="fa-solid fa-sort" id="sort-subject" style="font-size:10px; margin-left:5px; opacity:0.5;"></i>
                                        </th>
                                        <th style="border:none; padding: 12px; color: #D4AF37; cursor:pointer;" onclick="toggleLogSort('trigger_event')">
                                            Trigger <i class="fa-solid fa-sort" id="sort-trigger_event" style="font-size:10px; margin-left:5px; opacity:0.5;"></i>
                                        </th>
                                        <th style="border:none; padding: 12px; color: #D4AF37; cursor:pointer;" onclick="toggleLogSort('status')">
                                            Status <i class="fa-solid fa-sort" id="sort-status" style="font-size:10px; margin-left:5px; opacity:0.5;"></i>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody id="emailLogsBody">
                                    <tr id="emailLogsLoading">
                                        <td colspan="5" class="text-center" style="padding: 40px; border:none; opacity: 0.5;">
                                            <i class="fa fa-spinner fa-spin" style="margin-right: 10px;"></i> Fetching logs...
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <div id="emailLogsEmpty" class="um-empty-state" style="display:none; padding: 60px 20px;">
                                <i class="fa-solid fa-envelope-circle-check" style="font-size: 40px; opacity: 0.2; margin-bottom: 15px;"></i>
                                <p>No email logs found in the system.</p>
                            </div>
                        </div>

                        <!-- PAGINATION FOOTER -->
                        <div id="logPaginationContainer" style="margin-top: 25px; display:flex; justify-content:space-between; align-items:center; border-top: 1px solid rgba(255,255,255,0.05); padding-top:20px;">
                            <div id="logStats" style="font-size:13px; color:#888;">
                                Showing 0 to 0 of 0 logs
                            </div>
                            <div id="logPagination" class="um-pagination-btns" style="display:flex; gap:5px;">
                                <!-- Page buttons injected here -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Security & Audit Tab -->
            <div role="tabpanel" class="tab-pane fade" id="securityAdmin">
                <div class="um-shell">
                    <div class="um-header">
                        <div>
                            <h2 class="um-page-title"><i class="fa-solid fa-shield-halved"></i> Security & Audit</h2>
                            <p class="um-page-sub">Monitor system integrity, track administrative changes, and manage session security.</p>
                        </div>
                        <div class="um-header-actions">
                            <button class="um-btn um-btn--ghost" onclick="loadAuditLogs()">
                                <i class="fa-solid fa-rotate"></i> Refresh Audit Trail
                            </button>
                        </div>
                    </div>

                    <div class="row">
                        <!-- Security Status Card -->
                        <div class="col-md-4">
                            <div class="um-section-card" style="height: 100%;">
                                <h4 class="um-section-label">System Integrity</h4>
                                <div id="securityHealthStatus" style="margin-top: 15px;">
                                    <div style="display:flex; justify-content:space-between; align-items:center; background: rgba(76,175,80,0.1); border: 1px solid rgba(76,175,80,0.2); padding: 12px; border-radius: 8px; margin-bottom: 10px;">
                                        <span style="font-size: 13px; color: #eee;">Database Sync</span>
                                        <span style="color: #4CAF50; font-size: 11px; font-weight: bold; background: rgba(76,175,80,0.1); padding: 2px 8px; border-radius: 10px;">OPERATIONAL</span>
                                    </div>
                                    <div style="display:flex; justify-content:space-between; align-items:center; background: rgba(76,175,80,0.1); border: 1px solid rgba(76,175,80,0.2); padding: 12px; border-radius: 8px; margin-bottom: 10px;">
                                        <span style="font-size: 13px; color: #eee;">SSL/TLS Encryption</span>
                                        <span style="color: #4CAF50; font-size: 11px; font-weight: bold; background: rgba(76,175,80,0.1); padding: 2px 8px; border-radius: 10px;">ENFORCED</span>
                                    </div>
                                    <div style="display:flex; justify-content:space-between; align-items:center; background: rgba(255,152,0,0.1); border: 1px solid rgba(255,152,0,0.2); padding: 12px; border-radius: 8px;">
                                        <span style="font-size: 13px; color: #eee;">Session Expiry</span>
                                        <span id="sessionTimerBadge" style="color: #FF9800; font-size: 11px; font-weight: bold; background: rgba(255,152,0,0.1); padding: 2px 8px; border-radius: 10px;">MONITORING</span>
                                    </div>
                                </div>

                                <div style="margin-top: 25px; padding-top: 20px; border-top: 1px solid rgba(255,255,255,0.05);">
                                    <h4 class="um-section-label" style="font-size: 14px;">Recent Sign-ins</h4>
                                    <div id="recentLoginsList" style="margin-top: 10px; font-size: 12px; color: #888;">
                                        <div style="margin-bottom:8px;"><i class="fa-solid fa-user-check" style="margin-right:8px; color:#4CAF50;"></i> Admin from 127.0.0.1 <span style="float:right;">Just now</span></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Audit Trail List -->
                        <div class="col-md-8">
                            <div class="um-section-card">
                                <h4 class="um-section-label">Administrative Audit Trail</h4>
                                <p class="um-section-desc">Historical record of all modifications to bookings, events, and users.</p>

                                <div class="table-responsive" style="margin-top: 20px;">
                                    <table class="table" style="color: #eee; background: transparent; width: 100%;">
                                        <thead>
                                            <tr style="color: #D4AF37; border-bottom: 1px solid #333;">
                                                <th>Event</th>
                                                <th>Section</th>
                                                <th>Action</th>
                                                <th>Timestamp</th>
                                            </tr>
                                        </thead>
                                        <tbody id="auditLogsBody">
                                            <tr><td colspan="4" class="text-center" style="padding: 30px; opacity: 0.5;"><i class="fa fa-spinner fa-spin"></i> Initializing log stream...</td></tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div><!-- /.tab-content -->
