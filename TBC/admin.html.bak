            <!-- 3. Career Highlights -->
            <div role="tabpanel" class="tab-pane fade" id="careerAdmin">
                <div class="row">
                    <div class="col-md-5">
                        <div class="admin-card">
                            <h2>Career Highlight</h2>
<p class="text-muted">Fill out structured event details.</p><hr>
<div data-toggle="collapse" data-target="#collapseCareerForm" style="cursor: pointer; display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.05); padding: 10px; border-radius: 4px; border: 1px solid #333; margin-bottom: 15px; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.1)'" onmouseout="this.style.background='rgba(255,255,255,0.05)'">
