                                    <span style="font-weight:bold;">R <span id="qbSubtotal">0.00</span></span>
                                </div>
                                <div style="display:flex; justify-content:space-between; margin-bottom:10px; align-items:center;">
                                    <span style="color:#aaa; font-size:13px;">Discount (R):</span>
                                    <input type="number" id="qbDiscount" class="form-control input-sm text-right" style="width:100px; background:#111; border:1px solid #444; color:#fff;" value="0" min="0">
                                </div>
                                <div style="display:flex; justify-content:space-between; margin-bottom:10px; align-items:center;">
                                    <span style="color:#aaa; font-size:13px;"><input type="checkbox" id="qbApplyVat" style="margin-right:5px; vertical-align:middle;"> Apply VAT (15%)</span>
