                                <input type="date" class="form-control" id="quoteModalExpiry" style="background:#222;border:1px solid #444;color:#fff;"/>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div style="background:#222; padding:15px; border-radius:6px; border:1px solid #333;">
                                <div style="display:flex; justify-content:space-between; margin-bottom:10px;">
