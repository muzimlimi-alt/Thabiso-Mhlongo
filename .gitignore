node_modules/

# Environment / secrets — .env.example is a template and stays tracked
.env
.env.local
.env.*.local

# Runtime databases / session stores (regenerated at runtime, not source) — blanket pattern
# replaces the old mix of named files + partial wildcards, and also covers backups/, db-backups/,
# and any future throwaway test DB without needing its own line
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
# EXCEPTION: the production database is tracked. Render's free plan has no persistent disk,
# so local filesystem writes (including this file) don't survive a redeploy or an idle
# spin-down/wake cycle — the git-committed copy is the only thing that persists across those.
# Re-checkpoint the WAL (PRAGMA wal_checkpoint(TRUNCATE)) and re-commit after any admin
# changes you want to survive the next deploy. Test/throwaway *.sqlite files stay ignored.
!/database.sqlite

# Generated PDFs (invoices/quotes/contracts/attachments) — DOCS_PATH default (lib/runtime-paths.js).
docs/

# Backup output directories
backups/
db-backups/

# Admin-uploaded images now live in images/ alongside the site's own images (UPLOADS_PATH default). Those are
# public site content and may be committed with the database that references them; expense receipts are
# financial documents and must never enter this public repo.
images/receipts/

# Claude Code agent worktrees (full repo copies) - tooling artifacts, not project source
.claude/worktrees/

# Generated email preview HTML (js/generate-email-previews.js output, regenerable on demand)
email-previews/

# Local scratch / verification helpers and logs
scratch/
*.log
puppeteer_verify.js
verify_login_logs.js

# Installed Claude Code skill packages (vendored, reference data - not project source)
.claude/skills/
.agents/skills/
# Claude Code local/runtime artifacts - not shared project config
.claude/settings.local.json
.claude/scheduled_tasks.lock

# integration test throwaway docs/uploads (Phase 3 DOCS_PATH/UPLOADS_PATH overrides)
# (the throwaway test sqlite itself is now covered by the blanket *.sqlite rule above)
test/test-docs/
test/test-uploads/

# Temporary and test files directory
TBC/

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE configuration (personal, not shared project config)
.vscode/
.idea/
Thabiso Mhlongo Official Website.code-workspace

# Misc temp/cache safety nets
*.tmp
*.bak
.cache/
